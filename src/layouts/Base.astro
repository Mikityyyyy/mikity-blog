---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultOgImage, gaTrackingId, siteDescription, siteName, siteTagline } from "../lib/site-content";
import "../styles/global.css";

interface Props {
	title?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	/** 記事ページではEmDashのSEO設定とプラグインの出力を適用する */
	content?: { collection: string; id: string; slug?: string | null };
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description = siteDescription,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	content,
	jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | ${siteTagline}`;
const ogImage = new URL(image || defaultOgImage, Astro.url.origin).toString();
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteName,
	description,
	canonical: canonicalUrl,
	image: ogImage,
	content,
	seo: { ogImage, robots },
	articleMeta: { publishedTime, modifiedTime, author: "Mikity" },
	siteName,
});

const serializedJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
const enableAnalytics = import.meta.env.PROD;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#ffffff" />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-latin" preload />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@mikity__97" />
		<meta property="og:locale" content="ja_JP" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/icon.png" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />
		{serializedJsonLd && <script type="application/ld+json" set:html={serializedJsonLd} />}
		{
			enableAnalytics && (
				<>
					<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaTrackingId}`} />
					<script is:inline define:vars={{ gaTrackingId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag("js", new Date());
						gtag("config", gaTrackingId);
					</script>
				</>
			)
		}
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">本文へ移動</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
