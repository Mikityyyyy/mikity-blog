---
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="ページが見つかりません" robots="noindex">
	<div class="shell contact">
		<p class="eyebrow">404 — Not found</p>
		<h1>ページが見つかりません</h1>
		<p class="contact__lede">お探しのページは移動したか、削除された可能性があります。</p>
		<div class="essay__links">
			<a href="/blog" class="text-link">記事一覧へ <span aria-hidden="true">→</span></a>
			<a href="/" class="text-link text-link--muted">トップへ戻る</a>
		</div>
	</div>
</Base>
