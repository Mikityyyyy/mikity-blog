---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchiveHeader from "../../components/ArchiveHeader.astro";
import StoryList from "../../components/StoryList.astro";
import { contentPillars } from "../../lib/site-content";
import { withCategories } from "../../lib/posts";

const pillar = contentPillars.find((item) => item.slug === Astro.params.slug);
if (!pillar) return Astro.rewrite("/404");

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries, error, nextCursor, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	where: { category: pillar.slug },
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const stories = await withCategories(entries);
const path = `/category/${pillar.slug}`;
---

<Base title={`${pillar.title} — ${pillar.label}`} description={pillar.description} robots={cursor ? "noindex, follow" : null}>
	<div class="shell">
		<ArchiveHeader title={pillar.title} lede={`${pillar.label}。${pillar.description}`} active={pillar.slug} />
		<StoryList stories={stories} unavailable={Boolean(error)} emptyMessage={`${pillar.label}の記事を準備しています。`} />
		{
			(cursor || nextCursor) && (
				<nav class="pager" aria-label="ページ送り">
					{cursor && <a href={path}>← 最新へ</a>}
					{nextCursor && <a href={`${path}?cursor=${encodeURIComponent(nextCursor)}`}>次のページ →</a>}
				</nav>
			)
		}
	</div>
</Base>
