---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import StoryList from "../components/StoryList.astro";
import { contentPillars, currentGoals } from "../lib/site-content";
import { withCategories } from "../lib/posts";
import { works } from "../lib/works";

const { entries, error, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 7,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const unavailable = Boolean(error);
const stories = await withCategories(entries);
// トップの大きな写真はサイト紹介で固定し、記事はすべて新着として下に並べる
const latest = stories.slice(0, 6);
---

<Base>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero__media">
			<img
				class="hero__img"
				src="/sample-strength.webp"
				alt="朝の光が差し込む部屋でデスクとコーヒーに向かう後ろ姿"
				width="1200"
				height="896"
				fetchpriority="high"
			/>
		</div>
		<div class="hero__copy">
			<p class="eyebrow">Personal Blog</p>
			<h1 id="hero-title">仕事、身体、学び、暮らしの記録。</h1>
			<p class="hero__lede">
				会社員をしながら、筋トレを軸に身体を動かす毎日。トレーニングも、仕事も、学びも。試してわかったことを綴ります。
			</p>
			<a class="button" href="/about">このブログについて</a>
		</div>
	</section>

	<section class="section shell" aria-labelledby="latest-title">
		<header class="section__head">
			<h2 id="latest-title">Blog</h2>
			<p>新着記事</p>
		</header>
		<StoryList stories={latest} unavailable={unavailable} />
		{
			latest.length > 0 && (
				<div class="section__more">
					<a class="button button--ghost" href="/blog">すべての記事を見る</a>
				</div>
			)
		}
	</section>

	<section class="band" aria-labelledby="topics-title">
		<div class="section shell">
			<header class="section__head">
				<h2 id="topics-title">Topics</h2>
				<p>書いていること</p>
			</header>
			<ul class="topics">
				{
					contentPillars.map((topic) => (
						<li>
							<a href={`/category/${topic.slug}`}>
								<span class="eyebrow">{topic.number}</span>
								<span class="topics__title">{topic.title}</span>
								<span class="topics__label">{topic.label}</span>
								<span class="topics__desc">{topic.description}</span>
								<span class="topics__more">記事を見る</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		works.length > 0 && (
			<section class="section shell" aria-labelledby="works-title">
				<header class="section__head">
					<h2 id="works-title">Works</h2>
					<p>つくったもの</p>
				</header>
				<div class="story-grid works-grid">
					{works.map((work) => (
						<article class="story">
							<a href={`/works/${work.slug}`} class="story__link">
								<div class="story__media work-card__media">
									<img
										class="story__img"
										src={work.video?.poster ?? work.ogImage}
										alt={`${work.title}の画面`}
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="story__body">
									<p class="story__meta">
										<span>{work.category}</span>
										<span>{work.year}</span>
									</p>
									<h3 class="story__title">
										{work.title} — {work.tagline}
									</h3>
								</div>
							</a>
						</article>
					))}
				</div>
			</section>
		)
	}

	<section class="split" aria-labelledby="about-title">
		<div class="split__media">
			<img
				src="/journal-cover-training.webp"
				alt="自然光の差し込むジムでバーベルの前に立つ後ろ姿"
				width="1200"
				height="896"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="split__copy">
			<p class="eyebrow">About</p>
			<h2 id="about-title">Hello, I’m Mikity.</h2>
			<p>
				29歳の会社員。普段はBizDevとマーケティングを担当しています。筋トレを中心に、HYROXやマラソンにも挑戦。英語とAIも勉強中です。
			</p>
			<dl class="records">
				{
					currentGoals.map((goal) => (
						<div>
							<dt>{goal.label}</dt>
							<dd class="records__value">
								{goal.current}
								{goal.unit && <small>{goal.unit}</small>}
							</dd>
							<dd class="records__target">TARGET — {goal.target}</dd>
						</div>
					))
				}
			</dl>
			<a class="button button--ghost" href="/about">プロフィールを読む</a>
		</div>
	</section>
</Base>
