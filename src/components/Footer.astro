---
import { contentPillars, siteTagline, socialLinks } from "../lib/site-content";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell site-footer__grid">
		<div class="site-footer__brand">
			<a href="/" class="wordmark">mikitylife</a>
			<p>{siteTagline}</p>
		</div>
		<nav aria-labelledby="footer-sections">
			<h2 id="footer-sections" class="eyebrow">Journal</h2>
			<ul>
				<li><a href="/blog">すべての記事</a></li>
				{contentPillars.map((pillar) => <li><a href={`/category/${pillar.slug}`}>{pillar.title}</a></li>)}
			</ul>
		</nav>
		<nav aria-labelledby="footer-follow">
			<h2 id="footer-follow" class="eyebrow">Follow</h2>
			<ul>
				{
					socialLinks.map((social) => (
						<li>
							<a href={social.href} target="_blank" rel="noreferrer">
								{social.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<nav aria-labelledby="footer-site">
			<h2 id="footer-site" class="eyebrow">Info</h2>
			<ul>
				<li><a href="/works">Works</a></li>
				<li><a href="/about">About</a></li>
				<li><a href="/contact">Contact</a></li>
				<li><a href="/rss.xml">RSS</a></li>
			</ul>
		</nav>
	</div>
	<div class="shell site-footer__base">
		<p>© {year} mikitylife</p>
	</div>
</footer>
